# Runtime
# development (default) or production. Production enables config validation,
# HSTS, and refuses to start with a SQLite DATABASE_URL.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional host allow-list, e.g. duo-link-api.onrender.com,*.onrender.com
# ALLOWED_HOSTS=

# Database
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./duolink.db
# Supabase Postgres (session pooler). Use the full connection string from
# Supabase → Project Settings → Database → Connection string → Session pooler.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Public frontend origin used to build smart URLs, plus CORS allow-list.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for Vercel preview deployments:
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Supabase Auth (server-side only). Leave these blank/commented until you have
# real values; placeholders would make the app think auth is configured.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>
# Optional, reserved for future admin-only operations. Never expose to clients.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Auth performance and reliability
SUPABASE_TIMEOUT_SECONDS=10
# Seconds a validated access token is cached in memory (0 disables caching).
AUTH_CACHE_TTL_SECONDS=30
